# Postgres connection string. In production, use a hosted Postgres provider
# (Neon, Supabase, etc.) and paste its connection string here / into Vercel env vars.
DATABASE_URL="postgresql://user:password@localhost:5432/fantasy_week1?schema=public"

# Auth.js — generate with `npx auth secret`. Required: sessions are signed
# JWTs, so this key is what makes them unforgeable.
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Sets the commissioner's password when seeding (either `npx prisma db seed`
# or the /api/setup/bootstrap route below). If unset, the CLI generates and
# prints a random one-time password; the HTTP route requires this be set.
COMMISSIONER_PASSWORD=""

# Only needed if you're seeding via POST /api/setup/bootstrap instead of the
# CLI (e.g. no local terminal / seeding a deployment directly) — see README.
# Any random string; required to authorize that request. Leave unset to
# disable the route entirely.
SETUP_TOKEN=""

# Anthropic — used to generate the "hostile yet friendly" weekly recap prose.
# Without this set, a deterministic template generator is used instead so the
# app is fully functional with no API key.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# Yahoo Fantasy Sports API (lib/yahoo.ts) — NOT required for anything else in
# this app to work. Only needed once you register an app at
# https://developer.yahoo.com/apps/ and want to wire up the (not yet built)
# admin connect flow. YAHOO_REDIRECT_URI must exactly match the callback URL
# registered on that app. See README's "Future: Yahoo Fantasy API
# integration" section.
YAHOO_CLIENT_ID=""
YAHOO_CLIENT_SECRET=""
YAHOO_REDIRECT_URI=""
