// Fantasy Hockey League Recap — data model
// See README.md for an overview of how this schema maps to the app's features.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// League domain
// ---------------------------------------------------------------------------

enum Role {
  COMMISSIONER
  MEMBER
}

enum ScoringType {
  H2H_CATEGORIES
  ROTO
}

enum Position {
  C
  LW
  RW
  D
  G
}

/// Where a row's data came from. Every domain row that could plausibly be
/// synced from an external source carries this, so a sync job is just
/// another writer into the same tables instead of a schema rewrite.
enum DataSource {
  MANUAL
  CSV_IMPORT
  YAHOO_SYNC
  NHL_SYNC
}

enum TransactionType {
  ADD
  DROP
  TRADE
}

enum TransactionDirection {
  ADDED
  DROPPED
  TRADED_AWAY
  TRADED_FOR
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  /// bcrypt hash. Nullable so a manager row can exist before a password is
  /// set (e.g. commissioner adds them, they set it on first login later);
  /// a null hash can never successfully authenticate.
  passwordHash String?
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())

  team    Team?
  ratings TransactionRating[]
}

model League {
  id            String      @id @default(cuid())
  name          String
  scoringType   ScoringType @default(H2H_CATEGORIES)
  /// Roster shape, e.g. { "C": 1, "LW": 1, "RW": 1, "D": 2, "G": 1 }
  positionSlots Json
  createdAt     DateTime    @default(now())

  seasons    Season[]
  categories ScoringCategory[]
}

model Season {
  id       String @id @default(cuid())
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueId String
  year     Int

  weeks Week[]
  teams Team[]

  @@unique([leagueId, year])
}

model Week {
  id        String   @id @default(cuid())
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId  String
  number    Int
  startDate DateTime
  endDate   DateTime

  matchups       Matchup[]
  statLines      StatLine[]
  rosterSlots    WeeklyRosterSlot[]
  transactions   Transaction[]
  totwSelections TeamOfWeekSelection[]
  recapArticle   RecapArticle?

  @@unique([seasonId, number])
}

/// A configurable scoring category. Deliberately data-driven instead of a
/// fixed enum, since leagues (and Yahoo leagues especially) choose their own
/// category set.
model ScoringCategory {
  id             String     @id @default(cuid())
  league         League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  leagueId       String
  code           String
  label          String
  /// Which positions this category is tracked for (skater categories vs
  /// goalie categories, typically).
  appliesTo      Position[]
  /// false for categories like GAA where a lower value is better.
  higherIsBetter Boolean    @default(true)
  sortOrder      Int        @default(0)

  statLines       StatLine[]
  categoryResults MatchupCategoryResult[]

  @@unique([leagueId, code])
}

model Team {
  id             String     @id @default(cuid())
  season         Season     @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId       String
  manager        User       @relation(fields: [managerId], references: [id])
  managerId      String     @unique
  name           String
  externalSource DataSource @default(MANUAL)
  externalId     String?

  rosterEntries            RosterEntry[]
  weeklyRosterSlots        WeeklyRosterSlot[]
  homeMatchups             Matchup[]          @relation("HomeTeam")
  awayMatchups             Matchup[]          @relation("AwayTeam")
  transactions             Transaction[]      @relation("InitiatingTeam")
  counterpartyTransactions Transaction[]      @relation("CounterpartyTeam")

  @@unique([seasonId, name])
}

model Player {
  id              String     @id @default(cuid())
  fullName        String
  primaryPosition Position
  externalSource  DataSource @default(MANUAL)
  externalId      String?
  photoUrl        String?

  statLines            StatLine[]
  rosterEntries        RosterEntry[]
  weeklyRosterSlots    WeeklyRosterSlot[]
  transactionPlayers   TransactionPlayer[]
  teamOfWeekSelections TeamOfWeekSelection[]
  gameLogs             PlayerGameLog[]
}

/// Season-long "who owns this player" — distinct from the weekly
/// started/benched snapshot in WeeklyRosterSlot.
model RosterEntry {
  id        String    @id @default(cuid())
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String
  addedAt   DateTime  @default(now())
  droppedAt DateTime?
}

/// The weekly snapshot of who was started vs benched — required for the
/// Choker of the Week detector and for optimal-lineup% in Manager of the Week.
model WeeklyRosterSlot {
  id       String   @id @default(cuid())
  week     Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  weekId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId   String
  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String
  slot     Position
  started  Boolean

  @@unique([weekId, teamId, playerId])
}

model StatLine {
  id         String          @id @default(cuid())
  week       Week            @relation(fields: [weekId], references: [id], onDelete: Cascade)
  weekId     String
  player     Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId   String
  category   ScoringCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  value      Float
  source     DataSource      @default(MANUAL)

  @@unique([weekId, playerId, categoryId])
}

/// One row per player per real NHL game — separate from StatLine (which is
/// a per-fantasy-week aggregate). This is what makes "last 10 games" and
/// per-game ratings possible without depending on the commissioner having
/// run a weekly sync for every historical week; it's populated directly
/// from the NHL API's per-player game log, independent of our own Week
/// bookkeeping.
model PlayerGameLog {
  id       String     @id @default(cuid())
  player   Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId String
  gameDate DateTime
  opponent String?
  /// Raw per-category values for this single game, e.g. { "G": 1, "A": 2 }.
  values   Json
  source   DataSource @default(NHL_SYNC)

  @@unique([playerId, gameDate])
}

model Matchup {
  id               String  @id @default(cuid())
  week             Week    @relation(fields: [weekId], references: [id], onDelete: Cascade)
  weekId           String
  homeTeam         Team    @relation("HomeTeam", fields: [homeTeamId], references: [id])
  homeTeamId       String
  awayTeam         Team    @relation("AwayTeam", fields: [awayTeamId], references: [id])
  awayTeamId       String
  homeCategoryWins Float   @default(0)
  awayCategoryWins Float   @default(0)
  isTie            Boolean @default(false)

  categoryResults MatchupCategoryResult[]

  @@unique([weekId, homeTeamId, awayTeamId])
}

model MatchupCategoryResult {
  id         String          @id @default(cuid())
  matchup    Matchup         @relation(fields: [matchupId], references: [id], onDelete: Cascade)
  matchupId  String
  category   ScoringCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  homeValue  Float
  awayValue  Float
  /// "home" | "away" | null (tie)
  winner     String?

  @@unique([matchupId, categoryId])
}

model Transaction {
  id                 String          @id @default(cuid())
  week               Week            @relation(fields: [weekId], references: [id], onDelete: Cascade)
  weekId             String
  type               TransactionType
  initiatingTeam     Team            @relation("InitiatingTeam", fields: [initiatingTeamId], references: [id])
  initiatingTeamId   String
  /// Only set for TRADE — the other side of the trade. ADD/DROP only ever
  /// involve initiatingTeam, since Yahoo-style waiver moves are single-team.
  counterpartyTeam   Team?           @relation("CounterpartyTeam", fields: [counterpartyTeamId], references: [id])
  counterpartyTeamId String?
  timestamp          DateTime        @default(now())

  playersInvolved TransactionPlayer[]
  ratings         TransactionRating[]
}

model TransactionPlayer {
  id            String               @id @default(cuid())
  transaction   Transaction          @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String
  player        Player               @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId      String
  direction     TransactionDirection
}

model TransactionRating {
  id            String      @id @default(cuid())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String
  rater         User        @relation(fields: [raterId], references: [id], onDelete: Cascade)
  raterId       String
  score         Int
  comment       String?
  createdAt     DateTime    @default(now())

  @@unique([transactionId, raterId])
}

model TeamOfWeekSelection {
  id        String   @id @default(cuid())
  week      Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  weekId    String
  position  Position
  slotIndex Int      @default(0)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId  String
  rawScore  Float
  zScore    Float?
  /// 0-100, via the same z-score-to-rating scale as individual game ratings.
  rating    Int      @default(50)

  @@unique([weekId, position, slotIndex])
}

model RecapArticle {
  id               String    @id @default(cuid())
  week             Week      @relation(fields: [weekId], references: [id], onDelete: Cascade)
  weekId           String    @unique
  title            String
  generatedByModel String?
  promptVersion    String?
  isPublished      Boolean   @default(false)
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sections RecapSection[]
}

model RecapSection {
  id             String       @id @default(cuid())
  article        RecapArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId      String
  /// TOTW | TIGHTEST_MATCHUP | HARDEST_BEATING | CLUTCH | PICKUP | CLOWN |
  /// QUOTE | MANAGER_OF_WEEK | CHOKER | COMEBACK
  type           String
  order          Int
  title          String
  body           String
  structuredData Json?

  @@unique([articleId, type])
}
